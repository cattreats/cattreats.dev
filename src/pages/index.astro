---
import Base from "../layouts/base.astro";
import Social from "../components/socials.astro";
import SocialScript from "../components/socials-script.astro";
---

<Base title="Treats ⋆｡°✩">
  <div
    class="font-itim bg-ctp-surface0/75 flex flex-col rounded-lg p-4 backdrop-blur-md md:max-w-lg"
  >
    <div class="flex flex-row">
      <img
        src="images/pfp.gif"
        class="h-32 rounded-full"
        alt="Treats's profile photo"
      />
      <div class="align-left m-4 flex flex-col gap-0.5">
        <h1 class="text-ruby text-6xl font-extrabold">Treats</h1>
        <p class="text-ctp-subtext1 text-xl">she/her</p>
      </div>
    </div>
    <p class="text-ctp-subtext1 text-2xl font-medium" id="username">
      @cattreats
    </p>

    <p>
      i'm treats, a furry. :3 <br />my self-named sona, shade, is a black cat
      with big round glasses, and she's themed after the colours of one of my
      favourite drink (monster ultra ruby red) :3c
    </p>
    <div class="text-ctp-subtext1 flex justify-center gap-1 text-3xl">
      <Social
        hover="@catniptreats"
        icon="fa7-brands:discord"
        link="https://discord.com/users/1408956378600702042"
      />
      <Social
        hover="@cattreats"
        icon="fa7-brands:github"
        link="https://github.com/cattreats"
      />
      <Social
        hover="@cattreats.01"
        icon="fa7-brands:signal-messenger"
        link="https://signal.cattreats.dev"
      />
      <Social
        hover="catnip@cattreats.dev"
        icon="fa7-regular:envelope"
        link="mailto:catnip@cattreats.dev"
      />
    </div>
  </div>
  <SocialScript />
</Base>
